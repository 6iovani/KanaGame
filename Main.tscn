[sub_resource type="GDScript" id="GDScript_cm0pq"]
script/source = "extends Node2D

@onready var player = $player

var speed_increase: float = 10.0
var max_fall_speed: float = 250.0
signal correct(pos:Vector2)
signal wrong(pos:Vector2)


func _ready() -> void:
	player.set_health(player.health)
	player.press_enter.connect(_on_enter_pressed)
	player.player_death.connect(_on_player_death)
	print(\"selected mode: \", GameState.selected_mode)
	$mode_display.text += GameState.selected_mode
	print(\"selected level: \", GameState.selected_level)


func _on_enter_pressed(input: String) -> void:
	
	var kana_list = get_tree().get_nodes_in_group(\"kana\")
	var matching_kana = null
	
	for kana in kana_list:
		if input == kana.romanization:
			if matching_kana == null:
				matching_kana = kana
			elif kana.position.y > matching_kana.position.y:
				matching_kana = kana
	
	if matching_kana != null:
		var kana_position = matching_kana.position
		
		$\"sfx container/sfx_correct\".play()
		correct.emit(kana_position)
		matching_kana.queue_free()
		
	else:
		wrong.emit(Vector2(550.0,550.0))
		$\"sfx container/sfx_miss\".play()
		player.set_health(player.health - 1)
		

func _on_player_death()-> void:
	get_tree().change_scene_to_file(\"res://game_over_scene.tscn\")


func _on_difficulty_timer_timeout() -> void:
	
	if $kana_spawner/spawn_timer.wait_time > 1:
		$kana_spawner/spawn_timer.wait_time -= 0.2
	
	
	if $kana_spawner.new_fall_speed <= max_fall_speed:
		$kana_spawner.new_fall_speed += speed_increase
		print(\"fall speed for next kanas = \" + str($kana_spawner.new_fall_speed))
	else:
		print(\"max speed reached\")
	
"

